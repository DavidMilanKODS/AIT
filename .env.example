# Environment variables for AIT - TalentShare (Agrabad IT Talent Marketplace)

# Node Environment
NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL)
# e.g., postgresql://postgres:postgres@localhost:5432/ait_talentshare?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ait_talentshare?schema=public"

# Authentication & Security
JWT_SECRET="ait-talentshare-super-secret-jwt-key-change-in-production-2026"
SESSION_EXPIRY_DAYS=7

# Platform Settings
PLATFORM_DEFAULT_COMMISSION_RATE=0.20
PLATFORM_CURRENCY="BDT"
MIN_WITHDRAWAL_AMOUNT=500.00
MAX_UPLOAD_FILE_SIZE_MB=50

# Storage Driver: "local" or "s3"
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./uploads"
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION="auto"

# Payment Provider: "mock", "bkash", "nagad", "sslcommerz"
PAYMENT_PROVIDER="mock"
# BKASH_APP_KEY=""
# BKASH_APP_SECRET=""
# BKASH_USERNAME=""
# BKASH_PASSWORD=""

# Email Provider: "mock", "resend", "smtp"
EMAIL_PROVIDER="mock"
# RESEND_API_KEY=""
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="no-reply@ait.edu.bd"
